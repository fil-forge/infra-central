# Pulumi's local workspace state: which stack is selected, and the backend it was
# last logged into. Per-developer, and it changes as an operator moves between
# stages.
.pulumi/
Pulumi.*.yaml.bak

# Never commit a checkpoint. `pulumi stack export` writes state, including any
# output a stack marked secret, and the backend is where state belongs.
*.checkpoint.json
stack.json

# Every stage's Pulumi.<stack>.yaml *is* committed, deliberately, and there is no
# ignore rule above that would catch one. Per-stage configuration is non-secret by
# design: image digests, instance sizes, domain names, chain IDs. Every secret in
# this project lives in SSM and is minted by the provision Lambda, so a digest
# left on a developer's machine would simply never be deployed.

# Environment files. Never commit these: smelt shipped a tracked .env and an
# unignored .env.staging holding a live AWS_SECRET_ACCESS_KEY.
.env
.env.*

# Go build output
/dist/
/bin/

# docker buildx --metadata-file output, read by `make publish`
/build/metadata.json
