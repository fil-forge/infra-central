# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Per-stage configuration is non-secret by design: image digests, instance
# sizes, domain names, chain IDs. Every secret in this project lives in SSM and
# is minted by the provision Lambda, so these files are safe to commit and a
# VCS-driven HCP run needs them present.
!terraform.tfvars

# Written by `make publish` for the dev iteration loop. Machine-generated and
# per-developer, so it stays out of version control. Prod pins its digest in the
# committed terraform.tfvars instead.
image.auto.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Environment files. Never commit these: smelt shipped a tracked .env and an
# unignored .env.staging holding a live AWS_SECRET_ACCESS_KEY.
.env
.env.*

# Go build output
/dist/
/bin/

# docker buildx --metadata-file output, read by `make publish`
/build/metadata.json
